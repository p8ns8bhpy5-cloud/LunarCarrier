<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>农历运营商</string>
	<key>defaults</key>
	<string>com.yourname.lunarcarrier</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>开关</string>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchSpecifier</string>
			<key>label</key><string>锁屏显示农历</string>
			<key>key</key><string>LockEnabled</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchSpecifier</string>
			<key>label</key><string>任务栏显示农历</string>
			<key>key</key><string>SpringboardEnabled</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSToggleSwitchSpecifier</string>
			<key>label</key><string>去除闰字</string>
			<key>key</key><string>RemoveLeapChar</string>
			<key>default</key><false/>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>字体样式</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>字体颜色(hex)</string>
			<key>key</key><string>TextColor</string>
			<key>default</key><string></string>
			<key>placeholder</key><string>例如：FF0000 留空=默认</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>字体大小</string>
			<key>key</key><string>FontSize</string>
			<key>default</key><string></string>
			<key>placeholder</key><string>例如：14 留空=默认</string>
		</dict>
		<dict>
			<key>cell</key><string>PSRadioGroupCell</string>
			<key>label</key><string>字体粗细</string>
			<key>key</key><string>FontWeight</key>
			<key>default</key><string>regular</string>
			<key>validTitles</key>
			<array>
				<string>细</string>
				<string>轻</string>
				<string>常规</string>
				<string>中</string>
				<string>粗</string>
			</array>
			<key>validKeys</key>
			<array>
				<string>thin</string>
				<string>light</string>
				<string>regular</string>
				<string>medium</string>
				<string>bold</string>
			</array>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>年/月/日 分别替换</string>
			<key>footerText</key><string>用 || 分隔多组。例：月查找填 十一月||十二月，替换填 冬月||腊月</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>年·查找</string>
			<key>key</key><string>Find1</string>
			<key>default</key><string></string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>年·替换为</string>
			<key>key</key><string>Replace1</string>
			<key>default</key><string></string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>月·查找</string>
			<key>key</key><string>Find2</string>
			<key>default</key><string></string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>月·替换为</string>
			<key>key</key><string>Replace2</string>
			<key>default</key><string></string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>日·查找</string>
			<key>key</key><string>Find3</string>
			<key>default</key><string></string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>日·替换为</string>
			<key>key</key><string>Replace3</string>
			<key>default</key><string></string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>修改后请注销/重启 SpringBoard 后生效。</string>
		</dict>
	</array>
</dict>
</plist>
